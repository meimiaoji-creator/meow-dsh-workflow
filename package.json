{
  "name": "meow-dsh-workflow",
  "version": "0.1.0",
  "description": "dsh 插件：极简提示词生成器（v2.1）——Agent 定义存储 + 提示词生成 + meow_agent_call 子 agent 身份权限注入（双面插件包：node 半 storage/agentManager/tools + browser 半角色选择 UI）",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "deepseek",
    "multi-agent",
    "workflow",
    "subagents",
    "agent-roles",
    "memory",
    "ledger"
  ],
  "license": "MIT",
  "author": "meimiaoji-creator",
  "homepage": "https://github.com/meimiaoji-creator/meow-dsh-workflow#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/meimiaoji-creator/meow-dsh-workflow.git"
  },
  "bugs": {
    "url": "https://github.com/meimiaoji-creator/meow-dsh-workflow/issues"
  },
  "files": [
    "agents.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "lib/agent-manager.js",
    "lib/agent-manager.d.ts",
    "lib/agent-query-core.js",
    "lib/agent-query-core.d.ts",
    "lib/agent-query.js",
    "lib/agent-query.d.ts",
    "lib/agent-save-core.js",
    "lib/agent-save-core.d.ts",
    "lib/agent-save.js",
    "lib/agent-save.d.ts",
    "lib/agents-crud.js",
    "lib/agents-crud.d.ts",
    "lib/authorization.js",
    "lib/authorization.d.ts",
    "lib/child-list-core.js",
    "lib/child-list-core.d.ts",
    "lib/child-list.js",
    "lib/child-list.d.ts",
    "lib/client.js",
    "lib/client.js.map",
    "lib/commands-core.js",
    "lib/commands-core.d.ts",
    "lib/commands.js",
    "lib/commands.d.ts",
    "lib/index.js",
    "lib/index.d.ts",
    "lib/ledger-core.js",
    "lib/ledger-core.d.ts",
    "lib/ledger-store.js",
    "lib/ledger-store.d.ts",
    "lib/ledger.js",
    "lib/ledger.d.ts",
    "lib/memory-core.js",
    "lib/memory-core.d.ts",
    "lib/memory.js",
    "lib/memory.d.ts",
    "lib/presets.js",
    "lib/presets.d.ts",
    "lib/protocols.js",
    "lib/protocols.d.ts",
    "lib/schema.js",
    "lib/schema.d.ts",
    "lib/skill-filter.js",
    "lib/skill-filter.d.ts",
    "lib/static.js",
    "lib/static.d.ts",
    "lib/storage.js",
    "lib/storage.d.ts",
    "lib/tools-core.js",
    "lib/tools-core.d.ts",
    "lib/tools.js",
    "lib/tools.d.ts",
    "lib/web-routes.js",
    "lib/web-routes.d.ts",
    "lib/workflow-api.js",
    "lib/workflow-api.d.ts"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^0.1.0"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
